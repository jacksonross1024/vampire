sim:time-steps-increment= 2000 #10ps
sim:time-step= 0.1 !fs
sim:equilibration-time-steps= 0
sim:total-time-steps= 40000000

sim:cooling-function = linear

#------------------------------------------
# Program and integrator details
#------------------------------------------

#sim:program= time-series
sim:program= localised-temperature-pulse
sim:integrator= llg-midpoint
