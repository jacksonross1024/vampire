sim:two-temperature-heat-sink-coupling = 0.1e12 # 10ps  

sim:laser-pulse-power= 0.7 # 0.4 J/m^2 -> 4 mJ/cm^2 
sim:laser-pulse-time = 85 !fs # 5e-3 J/cm^2 / 5e-13 s -> 10 gw/cm^2
sim:second-laser-pulse-delay-time = 0 !ps


