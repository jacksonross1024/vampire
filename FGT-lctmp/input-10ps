#------------------------------------------
# Simulation attributes:
#------------------------------------------

sim:minimum-temperature= 40
sim:maximum-temperature= 40

sim:equilibration-temperature= 40
sim:temperature= 40

#sim:cooling-time = 0.5 !ns #10 ps -> 10,000
