# Adjacent-layer interface conductance (m/s). Symmetric Robin resistance 1/G.
# These finite values are the default. Co/Pt and Pt/Co, and Ta/Pt: 2e4.
# Co/Cu and Cu/Co: 3e4. Ta/SiO2: 0.1. A literal 0 is ignored and stays
# transparent; 1e12 m/s is the transparent comparison limit, not this file.
# Neighbours from the substrate upward. Each value is the layer above.
material[16]:spin-interface-conductance = 15, 0.1       # SiO2/Ta
material[15]:spin-interface-conductance = 14, 2.0e4     # Ta/Pt
material[14]:spin-interface-conductance = 13, 2.0e4     # Pt/Co
material[13]:spin-interface-conductance = 12, 2.0e4     # Co/Pt
material[12]:spin-interface-conductance = 11, 2.0e4     # Pt/Co
material[11]:spin-interface-conductance = 10, 2.0e4     # Co/Pt
material[10]:spin-interface-conductance = 9, 2.0e4      # Pt/Co
material[9]:spin-interface-conductance = 8, 2.0e4       # Co/Pt
material[8]:spin-interface-conductance = 7, 2.0e4       # Pt/Co
material[7]:spin-interface-conductance = 6, 3.0e4       # Co/Cu
material[6]:spin-interface-conductance = 5, 3.0e4       # Cu/Co
material[5]:spin-interface-conductance = 4, 2.0e4       # Co/Pt
material[4]:spin-interface-conductance = 3, 2.0e4       # Pt/Co
material[3]:spin-interface-conductance = 2, 2.0e4       # Co/Pt
material[2]:spin-interface-conductance = 1, 2.0e4       # Pt/Ta
