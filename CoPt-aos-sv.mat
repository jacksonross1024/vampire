#===================================================
# Co/Pt AOS heterostructure material file (16 materials)
#===================================================
# Stack (left = bottom = substrate, right = top = laser, units nm):
#   SiO2(5.0)/Ta(5)/Pt(4)/[Co(0.7)/Pt(1)]x3/Co(0.7)/Cu(10)/[Co(0.35)/Pt(0.8)]x2/Ta(5)
# Total thickness 37.1 nm. FCC, unit-cell 3.5 A. Co magnetic; metals NM remove.
# Vampire heights: z=0 bottom (SiO2), z=1 top (Ta-cap, laser).
# Thick Co(0.7)/Pt(1) sits on the 4 nm Pt, under the Cu. Thin Co(0.35)/Pt(0.8) is above the Cu, under the Ta cap.
# Numbered from the laser downward. Co-1 and Co-2 are materials 3 and 5 (thin, above the Cu). Co-3 to Co-6 are materials 7, 9, 11 and 13 (thick, under the Cu).
# Spin-valve transport replaces the laser-electrical torkance block.
# Co: P=0.6, De=1e-4 m^2/s, lambda_sf=10 nm, lambda_phi=2 nm, Jsd=4e-21 J, sa_inf=3e7 C/m^3.
#   P, De, lambda_sf, lambda_phi from Lepadatu et al., PRB 113, 094432 (2026), as in the AOS header.
#   Jsd and sa_inf from CoCuCo-sv.mat in this tree (Levy-Fert sa_inf kept nonzero).
# Pt: lambda_sf=5 nm, De=1e-4. Ta: lambda_sf=3 nm, De=1e-4. Cu: lambda_sf=350 nm, De=1e-3.
# SiO2: De=1e-5, lambda_sf=2 nm, sa_inf=0. NM layers are removed from the LLG.
# Their transport and heat-capacity constants still seed the 1D grid.
# SiO2 is 5.0 nm at z=0. Metal stack above it is 32.1 nm, in the order on the stack line. Total 37.1 nm. The 0.1 nm LTMP slice is not used here.
# Co demag-spin-coupling = 1.5066e6 (C/m^3)/muB. Serban low chi_sp = 2.4 kA/m,
# converted as chi = (e/mu_B)*chi_sp/|m0| with |m0| = 16*1.72 muB per 7.01 x 7.01 x 3.5 A cell.
# NM layers stay at 0. Directional pumping is the sa_inf*m-hat attractor; there is no second chi_sp term.
#
# SiO2 is a 5 nm substrate at z=0. non-magnetic = remove drops those atoms
# from the LLG. LTMP and the spin-current module still average their constants in.
#
# LTMP convention in this code:
#   electron-heat-capacity = Sommerfeld gamma  (J m^-3 K^-2), Ce = gamma * Te
#   phonon-heat-capacity   = Dulong-Petit C_inf (J m^-3 K^-1); Debye T from einstein-temp
#   einstein-temp          = theta_D / 1.25  (code stores 1.25 * value as Debye T)
#   electron-phonon-coupling G  (W m^-3 K^-1)
#   thermal conductivities kappa_e, kappa_p  (W m^-1 K^-1)
#
# --- Every numeric constant below, with its source ---
# Ag is commented under Cu (material 6). Same sources as the live metals.
#
# gamma (J m^-3 K^-2). Ce = gamma * Te.
#   Volumetric = (molar gamma) * (density / molar mass).
#   Co  710    4.73 mJ mol^-1 K^-2, Kang & Choi, Materials 14, 2755 (2021) Table 1
#   Pt  748    6.8 mJ mol^-1 K^-2, Lin, Zhigilei, Celli, PRB 77, 075133 (2008)
#   Cu   96.6  Lin, Zhigilei, Celli, PRB 77, 075133 (2008)
#   Ta  543    5.9 mJ mol^-1 K^-2, Kittel, Introduction to Solid State Physics, 7th ed.
#   Ag   63.3  0.65 mJ mol^-1 K^-2 * 10.5 g cm^-3 / 107.9 g mol^-1; Lin et al. PRB 77, 075133 (2008)
#   SiO2 1.55e6   not a Sommerfeld gamma. LTMP needs Ce > 0, so Ce is set equal to C_ph.
#
# C_ph (J m^-3 K^-1) = 3 n R, n = rho * N_A / M. Metals, Dulong-Petit limit:
#   Co  3.75e6   rho 8.86 g cm^-3, M 58.93 g mol^-1
#                (CRC Co density is 8.90 g cm^-3, which gives 3.77e6)
#   Pt  2.74e6   rho 21.45, M 195.08
#   Cu  3.52e6   rho 8.96,  M 63.55
#   Ta  2.29e6   rho 16.65, M 180.95
#   Ag  2.43e6   rho 10.49, M 107.87
#   Densities and molar masses: CRC Handbook of Chemistry and Physics.
#   SiO2 1.55e6  703 J kg^-1 K^-1 * 2200 kg m^-3.
#                Specific heat 703 J kg^-1 K^-1 and density 2.20 g cm^-3: Crystran fused-silica table.
#
# G (W m^-3 K^-1), ~300 K:
#   Co  1.09e18  Midpoint of Kang & Choi, Materials 14, 2755 (2021):
#                9.6e17 (indirect) and 1.22e18 (direct).
#   Pt  6.0e17   Jang, Kimling, Cahill, PRB 101, 064304 (2020): gep = (6+/-1)e17.
#                Earlier TDTR: 2.9e17 and 4.2e17. Photoemission: 6.8e17.
#                Lin et al. PRB 77, 075133 (2008) constant-lambda formula is ~1.1e18.
#   Cu  1.00e17  Lin et al. PRB 77, 075133 (2008) room-temperature value.
#                Their DFT G is ~8e16: Karna et al., Nat. Commun. (2024),
#                doi:10.1038/s41467-024-53441-9.
#   Ta  3.00e17  Smirnov, arXiv:2301.08625: "several x 10^17" from RT to ~45 kK.
#                XTANT-3 is lower (~5e16 near 600 K; Medvedev). 3e17 is the 300 K choice.
#   Ag  3.5e16   Room-temperature noble-metal value, range 2.5-3.5e16.
#                Lin, Zhigilei, Celli, PRB 77, 075133 (2008), G_Ag(Te).
#   SiO2 0       Insulator. No free-electron bath, same pattern as Al2O3/hBN in CrSBr-lctmp.
#
# kappa_e / kappa_ph (W m^-1 K^-1).
#   Bulk totals, Kittel 7th ed. (300 K table, W cm^-1 K^-1 x 100):
#     Co 100, Pt 72, Cu 401, Ta 58, Ag 429.
#   Kittel does not split electrons and phonons. Phonon piece assumed, then
#   kappa_e = total - kappa_ph. Phonon pieces are a few to ~16 W m^-1 K^-1,
#   the usual metal lattice share, not a separate measurement:
#     Co 10, Pt 6, Cu 16, Ta 5.5 (of 57.5), Ag 16.
#   Thin-film totals, both pieces scaled so the ratio stays the bulk ratio:
#     Co and Pt-1..Pt-5: total 15 = 13.5/1.5 (Co) and 13.75/1.25 (Pt).
#       Shahzadeh, Andriyevska, Salikhov, Fallarino, Hellwig, Pisana,
#       ACS Appl. Electron. Mater. 3, 1931 (2021), sample ML-1
#       [Pt(0.7 nm)/Co(0.4 nm)]128: cross-plane kz = 15.0.
#       (In-plane kr on that sample is 164. Heat flow here is vertical, so kz.)
#     Pt-seed, 4 nm: total 30 = 27.5/2.5. Below Kittel 72, above kz = 15.
#       A 7.3 nm Pt film is already ~24 (66% below bulk):
#       Yoneoka et al., Nano Lett. 12, 683 (2012). 30 is that film, not a new measurement.
#     Ta cap and Ta bottom, 5 nm: total 35 = 31.7/3.3.
#       Below Kittel ~58, above the multilayer 15. No 5 nm Ta measurement; interpolated.
#     Cu, 10 nm: bulk 385/16. Karna et al. (doi above): electron mean free path
#       ~39 nm, and films stay near bulk kappa while thickness and grains exceed it.
#       10 nm is under that length; bulk is kept anyway.
#     Ag swap: bulk 413/16 of the Kittel total 429.
#     SiO2: kappa_e = 0, kappa_ph = 1.38.
#       Crystran and Accuratus fused-silica tables, 1.38 W m^-1 K^-1 at room temperature.
#
# Debye temperature -> einstein-temp = theta_D / 1.25:
#   Cu 343 -> 274, Pt 240 -> 192, Ta 240 -> 192, Ag 225 -> 180.
#     Kittel, Introduction to Solid State Physics, 7th ed.
#   Co 385 -> 308. Kittel 7th ed. low-T limit for Co is 445 K.
#     385 K is the lower handbook value used here (room-temperature specific heat).
#   SiO2 einstein-temp = 274, so theta_D = 342 K in this file.
#     That is not the calorimetric vitreous-silica Debye temperature.
#     Anderson, J. Acoust. Soc. Am. 30, 671 (1958): thermal ~130 K, elastic ~1340 K.
#     274 only rolls C_ph off below theta_D; the glass stays near 300 K.
#
# 800 nm optical penetration delta = lambda / (4 pi k). Used in abs.txt, not as a mat key.
#   Co  n,k ~ 2.49, 4.80  Johnson & Christy, PRB 9, 5056 (1974)       -> 13.3 nm
#   Cu  n,k ~ 0.25, 5.01  Johnson & Christy, PRB 6, 4370 (1972)       -> 12.7 nm
#   Ag  n,k ~ 0.04, 5.6   Johnson & Christy, PRB 6, 4370 (1972)       -> 11.4 nm
#   Pt  n,k ~ 2.86, 4.96  Rakic et al., Appl. Opt. 37, 5271 (1998) BB -> 12.8 nm
#   Ta  n,k ~ 0.99, 7.29  Werner et al., JPCRD 38, 1013 (2009) REELS   ->  8.7 nm
#       Ordal et al., Appl. Opt. 27, 1203 (1988) IR table: k ~ 3.48 -> ~18 nm.
#       REELS is the value used for Ta.
#   SiO2 n ~ 1.45, k ~ 0 at 800 nm (Malitson, J. Opt. Soc. Am. 55, 1205 (1965) for n).
#       Transparent; it does not change the metal-average delta.
#   Piecewise I(z)/delta(z) is in abs.txt (z from the top). Surface Ta sets A = 1.
#   input-aos: penetration-depth = 87 A so the pump prefactor is 1/delta_Ta.
#
# Lattice and moments:
#   One FCC cell, a = 3.5 A, for every layer. Real cells differ
#   (Co ~3.54 A, Cu 3.61 A, Pt 3.92 A, Ta is bcc). 3.5 A is the common cell
#   so height fractions map onto the 37.1 nm stack. V_atom = a^3/4 = 1.072e-29 m^3.
#   Co atomic-spin-moment = 1.72 muB. Kittel saturation moment of Co;
#     also Vampire Co.mat.
#   Ta, Pt, Cu, SiO2 atomic-spin-moment = 1e-7 muB. Numerical floor so
#     non-magnetic = remove drops them. Not a measured moment.
#   Co damping-constant = 0.15. Bulk Co in Co.mat is 0.005; CoCuCo-sv.mat uses 0.1.
#     0.15 is the interface-enhanced Co/Pt value for these thicknesses
#     (ultrathin Co/Pt is typically 0.1-0.3).
#   Co exchange-matrix = 6.82e-21 J, taken from CoCuCo-sv.mat in this repo.
#     Interlayer Co-Co through Pt is omitted (Pt is non-magnetic).
#     Mean-field fcc, z = 12: Tc = z J / (3 k_B) ~ 1975 K.
#     Bulk Co Tc = 1388 K (Kittel). Thin-film Tc is the rescaling values below,
#     and those lines are commented out.
#
# Co/Pt PMA. Ku is per atom, from K_eff = 2 Ks / t_Co - (1/2) mu0 Ms^2.
#   Ks range in the literature ~0.3-1.3 mJ m^-2:
#     Shan et al., J. Appl. Phys. 73, 6344 (1993): Ks ~ 0.38 mJ m^-2
#     Krishnan et al.: 0.35 (MgO) to 0.6 (glass) mJ m^-2
#     Bandiera / nanoGUNE Co/Pt(111): 0.8-1.3 mJ m^-2
#   Used Ks = 0.8 mJ m^-2, inside the Co/Pt(111) range.
#   Ms = 1.4 MA m^-1, the usual Co saturation magnetisation
#     (1.72 muB on a ~3.54 A cell is ~1.44 MA m^-1).
#     (1/2) mu0 Ms^2 = 1.23 MJ m^-3.
#   Co 0.70 nm: K_eff = 1.05 MJ m^-3 -> Ku = 1.13e-23 J/atom
#   Co 0.35 nm: K_eff = 3.34 MJ m^-3 -> Ku = 3.58e-23 J/atom
#   Demagnetising term is inside Ku so PMA exists with the dipole solver off.
#   If the dipole solver is on, drop that piece (Ku = 2.45e-23 and 3.81e-23).
#   Zeper et al., J. Appl. Phys. 65, 4971 (1989): PMA for t_Co < ~1.2 nm;
#     full remanence for t_Co < 4.5 A.
#
# Curie temperatures (commented temperature-rescaling-curie-temperature):
#   Bulk Co Tc = 1388 K (Kittel).
#   Co ~4 A / Pt 10-20 A: Tc = 300-400 C = 573-673 K.
#     Zeper et al., IEEE Trans. Magn. 25, 3764 (1989).
#   Tc rises with t_Co and falls with t_Pt.
#     Bloemen et al., J. Appl. Phys. (1990); Hashimoto et al., J. Appl. Phys. 67, 2136 (1990).
#   Used: Co 0.35 nm (Pt 0.8 nm neighbours) Tc = 580 K
#         Co 0.70 nm (Pt 1.0 nm neighbours) Tc = 750 K
#
# Serban AOS spin-valve STT. Lepadatu et al., Phys. Rev. B 113, 094432 (2026).
#   Js = P (muB/e) Jc, then T_S = -(De/lambda_J^2) m x S - (De/lambda_phi^2) m x (m x S).
#   From that paper, for Co: P = 0.6, De = 1e-4 m^2/s, lambda_J = 4 nm,
#     lambda_phi = 2 nm, lambda_sf = 10 nm. lambda_sf is not an input here.
#   S = (k * lambda / De) Js. k = let-absorption-length-factor = 1.
#     k = 1 is the 1/e depth chosen for this file, not a number from the paper.
#     FL uses lambda_J, DL uses lambda_phi.
#   Tesla let-stt-fl/dl (commented) would be at sim:laser-electrical-current-ref,
#     scaled by Jc/Jc_ref. Torkance and De/lambda are scaled by Js.
#   Priority in the code: torkance > De+lambda > Tesla. One De per material.
#   let-polarisation-vector is a run choice. Torque is zero if it is parallel to m.
#   Live Co layers use 0,0,-1 with the initial spin also along z.
#
# Charge Seebeck. Serban et al. AOS spin-valve paper, Eq. (1) and Eq. (3):
#   J = σ Sc ∇Te − De ∇ne,   ∂ne/∂t = −∇·J,   J = 0 on the open walls.
#   Their Sc = +10 μV/K is one positive upper estimate for every metal, with σ = 1e7 S/m.
#   The value stored here is the absolute thermopower S (V/K). The solver uses
#   J = −σ S ∇Te − De ∇ne. With S negative, −S plays the role of their positive Sc:
#   conventional current points toward the hot end, electrons toward the cold end.
#   z = 0 is the bottom, so a hot top gives ∇Te > 0 and, for S < 0, J > 0.
#   Spin current takes this J through Eq. (4), Js = −(μB/e) P Jc m − De ∇S.
#   There is no separate S↑ − S↓ term. Their supplementary figure is this charge transient.
#   electrical-conductivity omitted keeps the Einstein value
#   σ = n e² D / (kB Te) with n = 1e28 m^-3. At 300 K and D = 1e-4 m²/s that is 6.2e6 S/m.
#   An explicit 0 is an insulator. SiO2 is 0. The metals omit the key.
#
# Absolute S at room temperature (V/K):
#   Co −22e-6, Pt −5e-6, Cu +1.6e-6.
#     Dejene, Flipse, van Wees, Phys. Rev. B 86, 024436 (2012), Table 2.
#     Measured on the films used in their Co and NiFe nanopillar spin valves.
#   Ta +1.5e-6.
#     Fiflis et al., Seebeck coefficient measurements on Li, Sn, Ta, Mo, and W (2013):
#     absolute S_Ta = +1.5 μV/K at 30 °C.
#   SiO2 0. No carrier thermopower in this model.
#   Ag swap (commented): +1.5e-6. Cu, Ag, Au absolute scale near +1.5 μV/K.
#
#===================================================

material:num-materials=16

#---------------------------------------------------
# Material 1: Ta-cap  5.0 nm  (from top 0.00-5.00 nm)
#---------------------------------------------------
material[1]:material-name=Ta-cap
material[1]:material-element=Ta
material[1]:minimum-height = 0.86522911
material[1]:maximum-height = 1.00000000
material[1]:non-magnetic = remove
material[1]:atomic-spin-moment = 1e-07 !muB
material[1]:electron-heat-capacity        = 543.0
material[1]:phonon-heat-capacity          = 2.29e+06
material[1]:electron-phonon-coupling      = 3.00e+17
material[1]:electron-thermal-conductivity = 31.7
material[1]:phonon-thermal-conductivity   = 3.3
material[1]:einstein-temp                 = 192
material[1]:spin-diffusion-length = 30.0
material[1]:spin-polarisation-conductivity = 0.001
material[1]:spin-polarisation-diffusion = 0.001
material[1]:spin-accumulation = 0.0
material[1]:diffusion-constant = 1.0e-4
material[1]:sd-exchange-constant = 0.0
material[1]:spin-dephasing-length = 30.0
material[1]:demag-spin-coupling = 0.0
material[1]:seebeck-coefficient = 1.5e-6

#---------------------------------------------------
# Material 2: Pt-1  0.8 nm  (from top 5.00-5.80 nm)
#---------------------------------------------------
material[2]:material-name=Pt-1
material[2]:material-element=Pt
material[2]:minimum-height = 0.84366577
material[2]:maximum-height = 0.86522911
material[2]:non-magnetic = remove
material[2]:atomic-spin-moment = 1e-07 !muB
material[2]:electron-heat-capacity        = 748.0
material[2]:phonon-heat-capacity          = 2.74e+06
material[2]:electron-phonon-coupling      = 6.00e+17
material[2]:electron-thermal-conductivity = 13.75
material[2]:phonon-thermal-conductivity   = 1.25
material[2]:einstein-temp                 = 192
material[2]:spin-diffusion-length = 50.0
material[2]:spin-polarisation-conductivity = 0.001
material[2]:spin-polarisation-diffusion = 0.001
material[2]:spin-accumulation = 0.0
material[2]:diffusion-constant = 1.0e-4
material[2]:sd-exchange-constant = 0.0
material[2]:spin-dephasing-length = 50.0
material[2]:demag-spin-coupling = 0.0
material[2]:seebeck-coefficient = -5.0e-6

#---------------------------------------------------
# Material 3: Co-1  0.35 nm  (from top 5.80-6.15 nm; one FCC cell)
#---------------------------------------------------
material[3]:material-name=Co-1
material[3]:material-element=Co
material[3]:minimum-height = 0.83423181
material[3]:maximum-height = 0.84366577
material[3]:damping-constant=0.15
material[3]:exchange-matrix[3]=6.82e-21
material[3]:atomic-spin-moment=1.72 !muB
material[3]:second-order-uniaxial-anisotropy-constant=3.58e-22
material[3]:uniaxial-anisotropy-direction = 0,0,1
material[3]:initial-spin-direction = 0,0,1
#material[3]:temperature-rescaling-curie-temperature = 580
material[3]:electron-heat-capacity        = 710.0
material[3]:phonon-heat-capacity          = 3.75e+06
material[3]:electron-phonon-coupling      = 1.09e+18
material[3]:electron-thermal-conductivity = 13.5
material[3]:phonon-thermal-conductivity   = 1.5
material[3]:einstein-temp                 = 308
material[3]:spin-diffusion-length = 100.0
material[3]:spin-polarisation-conductivity = 0.6
material[3]:spin-polarisation-diffusion = 0.6
material[3]:spin-accumulation = 3.0e7
material[3]:diffusion-constant = 1.0e-4
material[3]:sd-exchange-constant = 4.0e-21
material[3]:spin-dephasing-length = 20.0
material[3]:demag-spin-coupling = 1.5066e6
material[3]:seebeck-coefficient = -22.0e-6
# 1D spin-valve transport (Levy-Fert sa_inf, paper Co holders).
#material[3]:diffusion-constant = 1.0e-4

