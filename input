#------------------------------------------
# Sample vampire input file to perform
# benchmark calculation for v4.0
#
#------------------------------------------

#------------------------------------------
# Creation attributes:
#------------------------------------------

dimensions:system-size-x = 10 !nm
dimensions:system-size-y = 10 !nm
dimensions:system-size-z = 0.9 !nm

#create:periodic-boundaries-x
create:periodic-boundaries-y
#create:periodic-boundaries-z
create:local-alloy-radius = 7.5 #A
create:local-alloy-x-position = 0.75
create:local-alloy-y-position = 0.5
#------------------------------------------
# Material Files:
#------------------------------------------
material:unit-cell-file = fe3gate2-lda-Li-tetragonal.ucf
material:file = fe3gate2-Li.mat

#create:crystal-sublattice-materials=true
#create:crystal-structure = fe3gate2

#exchange:interaction-range = 2.85
#exchange:function = shell
#------------------------------------------
# Simulation attributes:
#------------------------------------------

sim:total-time-steps=1
sim:equilibration-temperature=10
sim:temperature=10
sim:equilibration-time-steps = 1
sim:time-steps-increment = 1

#sim:preconditioning-steps = 5000
sim:temperature-increment = 30
sim:minimum-temperature= 10
sim:maximum-temperature= 600

#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = domain-wall #time variable magnetic field; SOT; STT
sim:integrator = llg-heun

#sim:save-checkpoint = end 
#------------------------------------------
# data output
#------------------------------------------
config:atoms
config:atoms-output-rate=1

output:output-rate=1
#output:time-steps
output:temperature
output:mean-magnetisation-length
output:material-mean-magnetisation
output:mean-susceptibility
output:mean-material-spin-temperature
output:material-mean-total-energy 

