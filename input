#------------------------------------------
# System:
#------------------------------------------
dimensions:system-size-x = 30 !nm
dimensions:system-size-y = 30 !nm
dimensions:system-size-z = 0.6 !nm # 7247.207731 unit cells in total => 28988.83 atoms in total
create:periodic-boundaries-x
create:periodic-boundaries-y

#------------------------------------------
# Material:
#------------------------------------------
material:file= Co.mat
create:crystal-structure=fcc
dimensions:unit-cell-size = 3.524 !A
exchange:dmi-cutoff-range =  4.5 !A

exchange:static-dmi-vector = 0,0,1
#------------------------------------------
# Simulation attributes: 
#------------------------------------------
# real total time = equilibration-time-steps + total-time-steps
sim:total-time-steps=1000000
sim:equilibration-temperature=500
sim:time-steps-increment=10000
sim:time-step=1e-15 # 0.1 fs

sim:temperature=500
sim:maximum-temperature=500
sim:minimum-temperature=0
sim:cooling-time=500!ps
sim:cooling-function = linear

sim:applied-field-strength=0.01
sim:applied-field-unit-vector = 0,0,1
#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:integrator-random-seed = 1537

sim:program=field-cool
sim:integrator=llg-heun

sim:save-checkpoint = end
#------------------------------------------0
# data output
#------------------------------------------
screen:real-time

output:column-headers
output:real-time
output:temperature
output:applied-field-strength
output:applied-field-unit-vector 
output:magnetisation-length
output:material-magnetisation
output:total-energy

#output:spin-temperature
#output:mean-spin-temperature
#output:material-spin-temperature

output:output-rate=1

config:atoms
config:atoms-output-rate=10