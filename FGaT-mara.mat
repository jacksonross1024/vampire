
#---------------------------------------------------
# Number of Materials
#---------------------------------------------------
material:num-materials=2
#---------------------------------------------------
# Material 1
#---------------------------------------------------
material[1]:material-name=Fe1
#material[1]:damping-constant=1
material[1]:atomic-spin-moment=1.95!muB  #1.4!muB
material[1]:material-element=Fe
material[1]:uniaxial-anisotropy-direction=0,0,1
material[1]:uniaxial-anisotropy-constant=2.67e-23 # -> 0.1666483 meV vs  0.61 !meV 
material[1]:initial-spin-direction=  0,0,1
material[1]:unit-cell-category = 1

material[1]:exchange-matrix[1] = 1 
material[1]:exchange-matrix[2] = 1 


material[2]:material-name=Fe2
#material[2]:damping-constant=1
material[2]:atomic-spin-moment=1.56!muB #1.4!muB
material[2]:material-element=Fe
material[2]:uniaxial-anisotropy-direction=0,0,1
material[2]:uniaxial-anisotropy-constant=2.67e-23
material[2]:initial-spin-direction=  0,0,1
material[2]:unit-cell-category = 2

material[2]:exchange-matrix[1] = 1 
material[2]:exchange-matrix[2] = 1 

