material[1]:resistivity =  5e-8 #uOhm.cm -> 1e-8 Ohm.m @80K #npj 2D Materials and Applications volume 7, Article number: 52 (2023) 
material[1]:spin-resistivity =   2.67e-8 #uOhm.cm -> 1e-8 Ohm.m @80K
material[1]:spin-transport-precession-torque = 0.0
material[1]:spin-transport-relaxation-torque = 0.0


