
#------------------------------------------
# System Dimensions:
#------------------------------------------
#dimensions:unit-cell-size = 3.54 !A
dimensions:system-size-x = 150 !nm
dimensions:system-size-y = 150 !nm
dimensions:system-size-z = 2.0 !nm

#------------------------------------------
material:file= FGaT-mara-TiO2-islands.mat
material:unit-cell-file= fe3gate2-mara-dmi.ucf

#local-temperature-pulse:cell-size = 101,101,11.5 #A
#local-temperature-pulse:penetration-depth = 100
#local-temperature-pulse:output-microcell-data
