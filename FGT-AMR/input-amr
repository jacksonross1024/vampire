#local-temperature-pulse:absorption-profile-file = abs.txt 

# Creation attributes:
#------------------------------------------

#create:periodic-boundaries-x
#create:periodic-boundaries-y

#------------------------------------------
# Simulation attributes:
#------------------------------------------
spin-transport:cell-size-x = 5
spin-transport:cell-size-y = 5
spin-transport:cell-size-z = 10

spin-transport:current-direction = +z
spin-transport:applied-voltage = 1.0 #V
spin-transport:environment-resistivity = 1e12 #empty cell insulator
spin-transport:update-rate = 1


sim:equilibration-temperature= 80
sim:temperature= 80

sim:cooling-time = 0.1 !ns #10 ps -> 10,000
#sim:preconditioning-steps = 0
sim:time-steps-increment= 1 #10ps
sim:time-step= 0.01 !fs 
sim:equilibration-time-steps= 0
sim:total-time-steps= 1 #1 ns

#sim:cooling-function = linear
#------------------------------------------
# Program and integrator details
#------------------------------------------

#sim:program= field-cool
sim:program= electrical-pulse
sim:integrator= llg-midpoint
#montecarlo:algorithm = angle
#sim:integrator=llg-midpoint

sim:electrical-pulse-rise-time = 0.0 !ns
sim:electrical-pulse-fall-time = 0.0 !ns
sim:electrical-pulse-time = 1 !ns
sim:equilibration-field-strength = 0.4
sim:applied-field-strength = 0.4 #T

#sim:save-checkpoint = continuous
sim:load-checkpoint = restart 

