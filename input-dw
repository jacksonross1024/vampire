#------------------------------------------
# Sample vampire input file to perform
# benchmark calculation for v4.0
#
#------------------------------------------

#------------------------------------------
# Creation attributes:
#------------------------------------------
#dimensions:unit-cell-size = 2.507 !A

dimensions:system-size-x = 100.1 !nm
dimensions:system-size-y = 100.1 !nm
dimensions:system-size-z = 3.2 !nm

#create:periodic-boundaries-x
#create:periodic-boundaries-y
#create:periodic-boundaries-z
#------------------------------------------
# Material Files:
#------------------------------------------
material:unit-cell-file = CrSBr-Multilayer-Scaled-DMI.ucf
material:file = CrSBr-Multilayer-Scaled-Anisotropy.mat
create:crystal-sublattice-materials=true

sim:domain-wall-discretisation = 1,10,1
sim:domain-wall-discretisation-type = nm
sim:domain-wall-axis = x
sim:domain-wall-angle = 180
sim:domain-wall-width = 50
sim:domain-wall-position = 1000 

#------------------------------------------
# Simulation attributes:
#------------------------------------------
sim:equilibration-temperature = 0
sim:temperature = 0

sim:time-steps-increment = 1
sim:equilibration-time-steps=1
sim:total-time-steps = 10
sim:time-step = 0.1 !fs
#------------------------------------------
# Program and integrator details
#------------------------------------------
sim:program = domain-wall #time variable magnetic field; SOT; STT
sim:integrator = llg-heun

#------------------------------------------
# data output
#------------------------------------------
config:atoms 

output:output-rate=1
output:time-steps
output:material-magnetisation
output:total-torque
output:total-energy 
