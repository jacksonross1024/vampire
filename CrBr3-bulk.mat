# Mono-layer (Karstev 2021): J_11, lambda_11 =  3.32,    0.02069 !meV
#             J_22, lambda_22 =  0.3307, -0.002   !meV
#             J_33, lambda_33 = -0.0232,  -0.0017 !meV
# (T_C ~ 28K)
#  (approximating from Soenen 2021 CrI3 to get T_c ~ 45K)
#                       (2L)                  (mono)
#             J_11  = 7.90 (0.32)           J_11 = 7.58 (0.34)
#             J_22A = 1.10 (-0.08)          J_22 = 1.40 (-0.08)
#             J_22B = 1.22 (-0.08)          D_22 = 0.12
#               <J_22> = 0.58 (-0.08)
#               <D_22> = 0.1
#             J_12B = 0.53 (0.04) 
#             J_13A = 0.74 (0.04)
#             J_13B = 0.60 (0.04)
#               <J_13> = 0.67 (0.04)
#
#
# % shift 1L -> 2L:
#               J(2L)_11 = 1.0422 J(1L)_11 (0.94117)
#               J(2L)_22 = 0.7857 J(1L)_22 
#               J(2L)_12 = 0.37857 J(1L)_22 (0.5)
#               J(2L)_13 = 0.47857 J(1L)_22 (0.5)
#               D(2L)_22 = 0.07143  J(1L)_22

# % shift CrBr3 (1L) -> CrI3 (1L):
#               J_11(Br) = 0.4379947 (0.060853)
#               J_22(Br) = 0.2362 
#               
# 
#   "Bulk" CrBr3:
#               J_11 = 3.4726 (0.019473)
#               J_22 = 0.25983 (-0.002)
#               J_33 = -0.018228 (-0.0017)
#               J_12 = 0.098364 (0.001)
#               J_13 = 0.12435 (0.001)
#               D_22 = 0.018559
#

